APP_NAME="Join Meeting"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LOG_CHANNEL=stack
LOG_LEVEL=info
DB_CONNECTION=sqlite
# Empty uses backend/database/database.sqlite. Production: absolute persistent path.
DB_DATABASE=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Server-only service account JSON. Keep outside the checkout and public directory.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
# Optional local-only verification via Google REST. Production always uses Admin SDK.
FIREBASE_LOCAL_TOKEN_LOOKUP=false
FIREBASE_WEB_API_KEY=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
MEETING_MAX_PARTICIPANTS=12
MEETING_MAX_MINUTES=60
