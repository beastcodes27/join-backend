# Render with envsubst using the explicit variable list documented in deployment.md.
server {
    listen 80;
    server_name ${MEETING_DOMAIN} ${LIVEKIT_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name ${MEETING_DOMAIN};
    ssl_certificate ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    root /srv/join-meeting/frontend/dist;
    index index.html;
    client_max_body_size 64k;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)" always;
    add_header Cross-Origin-Opener-Policy same-origin-allow-popups always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.googleusercontent.com; media-src 'self' blob:; connect-src 'self' https://*.googleapis.com https://${FIREBASE_AUTH_DOMAIN} wss://${LIVEKIT_DOMAIN}; frame-src https://${FIREBASE_AUTH_DOMAIN} https://accounts.google.com; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    location ~ ^/(api/|sanctum/|up$) { try_files $uri /index.php?$query_string; }
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /srv/join-meeting/backend/public/index.php;
        fastcgi_param DOCUMENT_ROOT /srv/join-meeting/backend/public;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
        fastcgi_read_timeout 30s;
    }
    location ~ \.php$ { deny all; }
    location ~ /\.(?!well-known) { deny all; }
    location / { try_files $uri $uri/ /index.html; }
}
server {
    listen 443 ssl;
    http2 on;
    server_name ${LIVEKIT_DOMAIN};
    ssl_certificate ${TLS_CERT_PATH};
    ssl_certificate_key ${TLS_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    location / {
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }
}
